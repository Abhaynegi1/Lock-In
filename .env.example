# Environment Variables for Lock-In
# Copy this file to .env or pass these as --dart-define parameters

# WebSocket Battle Server (Render or Local)
BATTLE_SERVER_URL=wss://your-battle-server.onrender.com

# Supabase Configuration (Authentication & Cloud Backup)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Docker Compose Port Overrides (Optional)
# WEB_PORT=3000
# BATTLE_SERVER_PORT=8080

